# ---- Core ----
NODE_ENV=production
DATABASE_URL=postgresql://jmsurf:jmsurf@postgres:5432/jmsurf_hmis?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# ---- Integrations: point at mock-servers until you have real credentials ----
SHA_BASE_URL=http://mock-servers:4100/sha
SHA_CLIENT_ID=demo
SHA_CLIENT_SECRET=demo
MPESA_BASE_URL=http://mock-servers:4100/mpesa
MPESA_CONSUMER_KEY=demo
MPESA_CONSUMER_SECRET=demo
MPESA_SHORTCODE=174379
MPESA_PASSKEY=demo
MPESA_CALLBACK_URL=http://api:4000/api/payments/mpesa/callback
ETIMS_BASE_URL=http://mock-servers:4100/etims
ETIMS_PIN=P000000000A
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_SERIAL=demo
SMS_PROVIDER=mock
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=demo
DHIS2_BASE_URL=http://mock-servers:4100/dhis2
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district
ANTHROPIC_API_KEY=
# ---- Integration plumbing (revenue/integrations agent) ----
INTEGRATION_MAX_RETRIES=3
INTEGRATION_RETRY_BASE_MS=500
INTEGRATION_TIMEOUT_MS=20000
# SHA / HIE: paths are configurable because the official spec is issued to DHA-certified vendors (see docs/integrations/SHA_HIE.md)
SHA_SCOPE=
SHA_FACILITY_ID=
SHA_TOKEN_PATH=/oauth2/token
SHA_CR_PATH=/v1/client-registry/search
SHA_ELIGIBILITY_PATH=/v1/eligibility
SHA_PREAUTH_PATH=/v1/preauthorizations
SHA_CLAIM_PATH=/v1/claims
SHA_CLAIM_STATUS_PATH=/v1/claims/{ref}
# FHIR identifier/code system URIs (override when the HIE implementation guide publishes the official ones)
FHIR_SYSTEM_CR_ID=https://cr.health.go.ke/identifier/cr-id
FHIR_SYSTEM_NATIONAL_ID=https://cr.health.go.ke/identifier/national-id
FHIR_SYSTEM_SHA_NUMBER=https://sha.go.ke/identifier/member-number
FHIR_SYSTEM_KMHFR=https://kmhfr.health.go.ke/identifier/facility-code
FHIR_SYSTEM_SHA_FACILITY=https://sha.go.ke/identifier/facility-id
FHIR_SYSTEM_HWR=https://hwr.health.go.ke/identifier/registration-number
FHIR_SYSTEM_LICENCE=https://hwr.health.go.ke/identifier/licence-number
FHIR_SYSTEM_SHA_INTERVENTION=https://sha.go.ke/codesystem/intervention
# Claims engine
CLAIMS_POLL_ENABLED=true
CLAIMS_POLL_BATCH=200
CLAIMS_TARIFF_TOLERANCE_PERCENT=0
# M-Pesa extras
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_CALLBACK_TOKEN=
# KRA eTIMS (OSCU)
ETIMS_SALES_PATH=/trnsSales/saveSales
ETIMS_CMC_KEY=
ETIMS_DEFAULT_ITEM_CLASS=85121800
ETIMS_QR_BASE=https://etims.kra.go.ke/common/link/etims/receipt/indexEtimsReceiptData?Data=
FISCAL_DEFAULT_COUNTRY=KE
# SMS: mock | africastalking
AFRICASTALKING_BASE_URL=http://mock-servers:4100/sms
AFRICASTALKING_SENDER_ID=

# ---- Roadmap additions (security, AI, engagement, PACS) ----
# 32 bytes as base64 or 64 hex chars. Encrypts restricted clinical notes and MFA secrets. Unset in production = stored unencrypted (warning logged).
FIELD_ENCRYPTION_KEY=
REFRESH_TOKEN_DAYS=30
API_RATE_LIMIT_PER_MIN=1200
# dev/test only; "off" disables tenantId-filter warnings
TENANT_SCOPE_CHECK=on
AI_MODEL=claude-opus-5-5
# PACS (docker-compose.pacs.yml): public base URL of the OHIF viewer
ORTHANC_PUBLIC_URL=
# Patient reminders cron (SMS/WhatsApp): opt-in
REMINDERS_ENABLED=false
WHATSAPP_PROVIDER=mock
USSD_DEFAULT_TENANT=demo
