// ───────────────────────────── Patient engagement: portal, telemedicine, messaging, offline sync ─────────────────────────────

/// One-time passcodes for patient portal login (hashed; short-lived; limited attempts).
model PatientOtp {
  id         String    @id @default(uuid())
  tenantId   String
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, phone, createdAt])
}

/// Weekly working hours a practitioner offers for booking (portal / USSD / reception).
model PractitionerAvailability {
  id             String   @id @default(uuid())
  tenantId       String
  facilityId     String?
  practitionerId String
  weekday        Int // 0 = Sunday ... 6 = Saturday
  startTime      String // "08:00" (facility local time)
  endTime        String // "17:00"
  slotMinutes    Int      @default(30)
  modes          String[] @default(["IN_PERSON", "TELEMEDICINE"])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([tenantId, practitionerId])
}

/// Per-tenant message templates. code e.g. APPT_REMINDER_24H; lang "en" | "sw". Placeholders {{name}}.
model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
  lang      String   @default("en")
  channel   String   @default("SMS") // SMS, WHATSAPP
  body      String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code, lang, channel])
}

/// Every reminder sent (dedupe key prevents repeats).
model ReminderLog {
  id        String   @id @default(uuid())
  tenantId  String
  kind      String // APPT_24H, APPT_2H, IMMUNIZATION_DUE, RESULTS_READY, BILL_BALANCE
  refId     String
  patientId String?
  channel   String   @default("SMS")
  to        String
  lang      String   @default("en")
  body      String
  status    String   @default("SENT") // SENT, FAILED, SKIPPED
  createdAt DateTime @default(now())

  @@unique([tenantId, kind, refId])
  @@index([tenantId, createdAt])
}

/// Patient communication preferences.
model PatientPreference {
  id        String   @id @default(uuid())
  tenantId  String
  patientId String   @unique
  language  String   @default("en")
  whatsapp  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Patient feedback / NPS survey.
model PatientFeedback {
  id        String   @id @default(uuid())
  tenantId  String
  patientId String
  visitId   String?
  score     Int // 0-10 NPS
  comment   String?
  channel   String   @default("PORTAL")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Telemedicine consult attached to an appointment (mode TELEMEDICINE).
model TelemedicineSession {
  id              String    @id @default(uuid())
  tenantId        String
  appointmentId   String    @unique
  roomName        String    @unique
  url             String
  feeMinor        Int       @default(0)
  visitId         String?
  billId          String?
  doctorJoinedAt  DateTime?
  patientJoinedAt DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
}

/// Stored responses for offline-replayed writes (Idempotency-Key header).
model IdempotencyRecord {
  id         String   @id @default(uuid())
  tenantId   String
  key        String
  method     String
  path       String
  statusCode Int
  response   Json?
  createdAt  DateTime @default(now())

  @@unique([tenantId, key])
}
